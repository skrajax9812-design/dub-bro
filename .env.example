# Required — Postgres connection used by src/db/index.ts
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional — override the ffmpeg/ffprobe binaries.
# Useful when the ffmpeg-static / ffprobe-static postinstall download is blocked.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Optional — Python interpreter that has faster-whisper + edge-tts installed.
# PYTHON_BIN=python3

# Optional — Whisper model size (tiny | base | small | medium | large-v3)
# WHISPER_MODEL=base

# Optional — translation providers, tried in this order
# GROQ_API_KEY=
# OPENAI_API_KEY=

# Optional — where models, uploads and job outputs are written.
# Default: ./data inside the project. In the Arena sandbox this points outside
# the workspace (/opt/dubforge/data) so the per-turn workspace snapshot stays
# small enough to survive.
# DUB_DATA_DIR=/opt/dubforge/data
